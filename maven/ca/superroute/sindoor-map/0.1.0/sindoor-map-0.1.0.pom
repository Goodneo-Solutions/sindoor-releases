  <modelVersion>4.0.0</modelVersion>
  <groupId>ca.superroute</groupId>
  <artifactId>sindoor-map</artifactId>
  <version>0.1.0</version>
  <packaging>aar</packaging>
  <name>sIndoor map for Android</name>
  <description>The sIndoor navigation screen on sMap: the site as sMap's indoor layer, the blue dot, the route and its steps.</description>
